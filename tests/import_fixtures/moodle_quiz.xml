  <question type="multichoice">
    <name><text>Powerhouse</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>Which organelle is the <strong>powerhouse</strong> of the cell?</p><p><img src="@@PLUGINFILE@@/cell.png" alt="A cell diagram" width="200"></p>]]></text>
    </questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Mitochondria make ATP.</p>]]></text></generalfeedback>
    <defaultgrade>2.0000000</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[<p>Mitochondrion</p>]]></text><feedback format="html"><text>Yes</text></feedback></answer>
    <answer fraction="0" format="html"><text>Nucleus</text><feedback format="html"><text></text></feedback></answer>
    <answer fraction="0" format="html"><text>Ribosome</text></answer>
  </question>
